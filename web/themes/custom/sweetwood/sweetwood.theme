<?php

/**
 * @file
 * Theme functions for Sweetwood.
 */

use Drupal\Core\Cache\CacheableMetadata;

/**
 * Implements hook_preprocess_HOOK() for page templates.
 *
 * Exposes the site name and slogan to page.html.twig for the front-page hero.
 */
function sweetwood_preprocess_page(array &$variables): void {
  $site_config = \Drupal::config('system.site');
  $variables['site_name'] = $site_config->get('name');
  $variables['site_slogan'] = $site_config->get('slogan');
  CacheableMetadata::createFromRenderArray($variables)
    ->addCacheableDependency($site_config)
    ->applyTo($variables);
}

/**
 * Implements hook_preprocess_HOOK() for block templates.
 *
 * The front page shows the site name in the hero, so its node title is hidden.
 */
function sweetwood_preprocess_block(array &$variables): void {
  if (($variables['plugin_id'] ?? '') === 'page_title_block') {
    $variables['#cache']['contexts'][] = 'url.path.is_front';
    if (\Drupal::service('path.matcher')->isFrontPage()) {
      $variables['attributes']['class'][] = 'visually-hidden';
    }
  }
}
